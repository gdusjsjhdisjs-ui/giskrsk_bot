# ============================================
# ГИС Красноярье — настройки бота (v11)
# Скопируйте этот файл в .env и заполните значения
# ============================================

# --- Telegram (ОБЯЗАТЕЛЬНО) ---
BOT_TOKEN=токен_от_BotFather
APP_BASE_URL=http://localhost:8000

# --- PostgreSQL (обязательно, если USE_SQLITE=false) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=webgis_bot
POSTGRES_USER=webgis
POSTGRES_PASSWORD=придумайте_пароль

# --- Быстрый режим без PostgreSQL (для локального теста) ---
# true = база хранится в файле SQLite, PostgreSQL не нужен
USE_SQLITE=false

# --- Redis (нужен для лимитов и кэша; проще всего через Docker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# --- NextGIS Web (ОБЯЗАТЕЛЬНО) ---
NEXTGIS_BASE_URL=https://zimin-maplive0000.nextgis.com
NEXTGIS_LOGIN=ваш_логин
NEXTGIS_PASSWORD=ваш_пароль
NEXTGIS_BEARER_TOKEN=ваш_токен
NEXTGIS_PARCELS_RESOURCE_ID=0
NEXTGIS_PZZ_RESOURCE_ID=0

# --- YooKassa (ОБЯЗАТЕЛЬНО; тестовые ключи можно взять в ЛК ЮKassa) ---
YOOKASSA_SHOP_ID=ваш_shop_id
YOOKASSA_SECRET_KEY=ваш_секретный_ключ

# --- Админы бота (Telegram ID через запятую в скобках) ---
ADMIN_IDS=[123456789]

# --- Лимиты запросов в день ---
DAILY_LIMIT_FREE=3
DAILY_LIMIT_BASIC=30
DAILY_LIMIT_PRO=100

# --- Цены тарифов, ₽ ---
TARIFF_BASIC_30D_PRICE=2990
TARIFF_PRO_30D_PRICE=4990
TARIFF_PRO_90D_PRICE=9900
TARIFF_YEAR_PRICE=24900

# --- DeepSeek AI (для AI-анализа участков) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Мониторинг торгов ---
MONITOR_CHECK_INTERVAL_MINUTES=60

# --- PDF-отчёты ---
PDF_OUTPUT_DIR=/tmp/webgis_pdfs

# --- Магазин геоданных ---
# Номер карты для приёма переводов (показывается покупателю)
SHOP_CARD_NUMBER=0000 0000 0000 0000
SHOP_FILES_DIR=shop_files

# --- Мини-приложение (URL веб-аппа с картой, https) ---
WEBAPP_URL=

# --- Клип геоданных (вырезка по области) ---
CLIP_PRICE_PER_KM2=200
CLIP_MIN_PRICE=990
CLIP_MIN_MULTIPLIER=2.0

# --- Поддержка (ник в Telegram без @) ---
SUPPORT_USERNAME=

# --- Логи ---
LOG_LEVEL=INFO
